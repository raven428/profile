#!/bin/sh
# cspell:ignore xauth proto SSHRC
# Run by sshd via sh for every connection, stdout must stay empty (sshd(8), SSHRC).
# X11 cookie block from sshd(8): sshd skips its own xauth call when this file exists.
if read -r proto cookie && [ -n "${DISPLAY}" ]; then
  if [ "$(echo "${DISPLAY}" | cut -c1-10)" = 'localhost:' ]; then
    # X11UseLocalhost=yes
    echo add "unix:$(echo "${DISPLAY}" | cut -c11-)" "${proto}" "${cookie}"
  else
    # X11UseLocalhost=no
    echo add "${DISPLAY}" "${proto}" "${cookie}"
  fi | xauth -q - >&2
fi
# publish the forwarded agent socket and DISPLAY for VS Code terminals, tmux and screen
stable="${HOME}/.config/bash/ssh-agent-stable.sh"
if [ "${SSH_AGENT_STABLE-}" != 'off' ] && [ -r "${stable}" ] && [ -x /bin/bash ]; then
  exec /bin/bash "${stable}" --publish </dev/null >&2
fi
exit 0
